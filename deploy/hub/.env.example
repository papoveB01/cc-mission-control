# Copy to .env (same folder) and chmod 600 it. .env is gitignored. Never commit it.

# Tailscale auth key (https://login.tailscale.com/admin/settings/keys).
# One-off: reusable=false, ephemeral=false. Only used on first start; after that
# the node identity lives in the ts-state volume.
TS_AUTHKEY=
# Optional extra `tailscale up` flags, e.g. --advertise-tags=tag:ccmc-hub
# (the auth key must be allowed to use that tag).
TS_EXTRA_ARGS=

# Hub token, at least 32 characters; the hub refuses to start without it.
# Generate: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
CCMC_HUB_TOKEN=

# 0 = keep history forever
CCMC_HUB_RETENTION_DAYS=0
# Daily backups kept in /data/backups
CCMC_HUB_BACKUPS=7

# Optional. Leave it empty: the hub then accepts Host "ccmc-hub" and
# "ccmc-hub.<tailnet>.ts.net" (any tailnet), which is what you want here.
# Setting it REPLACES that default (the tailnet name is no longer accepted
# automatically), so list every name you use, e.g.:
# CCMC_HUB_HOSTS=ccmc-hub,ccmc-hub.example-tailnet.ts.net
CCMC_HUB_HOSTS=
